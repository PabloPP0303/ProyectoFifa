<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#2d6a4f">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Foto jugador -->
        <ImageView
            android:id="@+id/imgJugador"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:contentDescription="Foto jugador"
            android:src="@drawable/logoapp"/>

        <!-- Nombre, club, posición -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/nombreJugador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/clubJugador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Club"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/posicionJugador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Posición"
                android:textColor="#AAFFAA"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Valoración -->
        <TextView
            android:id="@+id/valoracionJugador"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="90"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="@drawable/ic_launcher_background"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>