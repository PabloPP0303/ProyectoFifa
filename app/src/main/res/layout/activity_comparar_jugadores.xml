<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_fondo">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloComparar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comparar Jugadores"
            android:textColor="@color/dorado"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Switch filtrar por liga -->

        <!-- JUGADOR 1 -->

        <Switch
            android:id="@+id/switchLiga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Solo Premier League"
            android:textColor="@color/blanco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.099"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloComparar" />

        <Switch
            android:id="@+id/switchLiga1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Solo LaLiga"
            android:textColor="@color/blanco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.682"
            app:layout_constraintStart_toEndOf="@+id/switchLiga"
            app:layout_constraintTop_toBottomOf="@id/tvTituloComparar" />

        <TextView
            android:id="@+id/tvJugador1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 1"
            android:textColor="@color/dorado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/switchLiga"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/editBuscar1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Buscar jugador..."
            android:textColorHint="@color/verde_claro"
            android:textColor="@color/blanco"
            android:backgroundTint="@color/dorado"
            android:inputType="textPersonName"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvJugador1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Spinner
            android:id="@+id/spinner1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/dorado"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/editBuscar1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- JUGADOR 2 -->
        <TextView
            android:id="@+id/tvJugador2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugador 2"
            android:textColor="@color/dorado"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/spinner1"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/editBuscar2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Buscar jugador..."
            android:textColorHint="@color/verde_claro"
            android:textColor="@color/blanco"
            android:backgroundTint="@color/dorado"
            android:inputType="textPersonName"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvJugador2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Spinner
            android:id="@+id/spinner2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/dorado"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/editBuscar2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Botón Comparar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComparar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="COMPARAR"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:backgroundTint="@color/dorado"
            android:textColor="@color/verde_fondo"
            app:layout_constraintTop_toBottomOf="@id/spinner2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Resultado comparación -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResultado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/verde_card"
            app:layout_constraintTop_toBottomOf="@id/btnComparar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nombres -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNombre1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/dorado"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="Jugador 1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VS"
                        android:textColor="@color/blanco"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvNombre2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/dorado"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="Jugador 2"/>

                </LinearLayout>

                <!-- Fila RIT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <TextView android:id="@+id/tvRit1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RIT" android:textColor="@color/blanco" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvRit2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                </LinearLayout>

                <!-- Fila TIR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/tvTir1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TIR" android:textColor="@color/blanco" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvTir2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                </LinearLayout>

                <!-- Fila PAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/tvPas1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PAS" android:textColor="@color/blanco" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvPas2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                </LinearLayout>

                <!-- Fila REG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/tvReg1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="REG" android:textColor="@color/blanco" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvReg2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                </LinearLayout>

                <!-- Fila DEF -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/tvDef1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DEF" android:textColor="@color/blanco" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvDef2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                </LinearLayout>

                <!-- Fila FIS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView android:id="@+id/tvFis1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="FIS" android:textColor="@color/blanco" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvFis2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:textColor="@color/dorado"
                        android:textSize="16sp" android:textStyle="bold" android:text="00"/>
                </LinearLayout>

                <!-- Ganador -->
                <TextView
                    android:id="@+id/tvGanador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/dorado"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="🏆 Ganador: "/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>